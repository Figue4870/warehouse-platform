# ===== Bodega WH-001 (valores SOLO para desarrollo local) =====
WH_ID=WH-001

# PostgreSQL (fuente de verdad de la bodega)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=warehouse_db
DB_PORT=5433

# API y frontend
BE_PORT=8001
FE_PORT=8081

# Redis (Fase 2 - caché). Puerto en tu PC; dentro de Docker siempre es 6379
REDIS_PORT=6380
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

# RabbitMQ de la bodega (Fase 3). Puertos en tu PC; dentro de Docker: 5672 y 15672
RABBIT_USER=warehouse
RABBIT_PASSWORD=warehouse
RABBIT_PORT=5673
RABBIT_MGMT_PORT=15673
# sync | async | both  (quién borra la clave de Redis tras un movimiento)
CACHE_INVALIDATION_MODE=both
# Segundos de espera artificial en el report-worker (para ver el estado PROCESSING)
REPORT_SIMULATED_DELAY_SECONDS=0
