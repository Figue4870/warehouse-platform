# ===== Bodega WH-002 (valores SOLO para desarrollo local) =====
WH_ID=WH-002

# PostgreSQL (fuente de verdad de la bodega)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=warehouse_db
DB_PORT=5434

# API y frontend
BE_PORT=8002
FE_PORT=8082

# Redis (Fase 2 - caché). Puerto en tu PC; dentro de Docker siempre es 6379
REDIS_PORT=6381
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
