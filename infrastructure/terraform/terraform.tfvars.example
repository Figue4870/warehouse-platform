# plantilla para terraform.tfvars

# Repositorio
repo_url    = "https://github.com/Figue4870/warehouse-platform.git"
repo_branch = "main"

# Acceso a las instancias
# admin_cidr   = "IP_PROPIA/32"
# allowed_cidr = "0.0.0.0/0"

# Tipos de instancia EC2
# instance_type         = "t3.small"
# central_instance_type = "t3.small"

# Configuracion de RabbitMQ central
central_rabbit_password = "cambiar-clave"

# Secreto maestro: de él se derivan las claves del heartbeat, del RDS, del directorio y de los avisos
heartbeat_secret = "cambiar-secreto-heartbeat"

# Central: base en RDS y un segundo nodo de la API detrás de un ALB
# central_database  = "rds"          # o "contenedor" (sin RDS; entonces central_api_nodes = 0)
# central_api_nodes = 1

# Logs de los contenedores en CloudWatch (7 días)
# cloudwatch_logs = true

# Reportes con Athena
# enable_analytics = true
