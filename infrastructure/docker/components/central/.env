# API central (Swagger en http://localhost:8090/docs)
CENTRAL_PORT=8090

# PostgreSQL del modelo de lectura (CQRS)
CENTRAL_DB_USER=postgres
CENTRAL_DB_PASSWORD=postgres
CENTRAL_DB_NAME=central_db
CENTRAL_DB_PORT=5440

# RabbitMQ central: aquí llegan los eventos de TODAS las bodegas
CENTRAL_RABBIT_USER=platform
CENTRAL_RABBIT_PASSWORD=platform
CENTRAL_RABBIT_PORT=5680
CENTRAL_RABBIT_MGMT_PORT=15680

# Heartbeat: cada cuánto se pregunta, segundos sin respuesta válida para marcar OFFLINE
# y clave de cada bodega (la misma que HEARTBEAT_SECRET en su .env)
HEARTBEAT_POLL_SECONDS=15
ONLINE_AFTER_SECONDS=45
WAREHOUSE_HEARTBEAT_SECRETS=WH-001=dev-wh001-lzURmRfrOZNxABgJL7Q-OroC,WH-002=dev-wh002-UdBv84HylruYKEVKu5CEixaB,WH-003=dev-wh003-0BrgjyTE_xUuDlqS8QdvLITB

# Fase 6 
SAGA_STEP_TIMEOUT_SECONDS=60
SAGA_ALLOW_SIMULATION=true

# Reportes con Athena: cada cuánto se exporta y cada cuánto se toma la foto del inventario.
EXPORT_INTERVAL_SECONDS=60
EXPORT_SNAPSHOT_SECONDS=3600

# Directorio de usuarios (OpenLDAP). Valores de desarrollo: en AWS, runtime.env los reemplaza.
# Los usuarios iniciales (admin.global, lider, admin.wh00X, registrador.wh00X) se crean con LDAP_SEED_PASSWORD.
LDAP_ADMIN_PASSWORD=dev-ldap-admin
LDAP_SEED_PASSWORD=Bodegas2026!
LDAP_PORT=3890
